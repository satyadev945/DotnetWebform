@page "{id:int}"
@model eShop.Web.Pages.Catalog.DetailsModel
@{
    ViewData["Title"] = "Details";
}

<div class="container">
    <h1 class="my-4">Catalog Item Details</h1>

    @if (Model.Item != null)
    {
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">@Model.Item.Name</h5>
                <div class="row">
                    <div class="col-md-6">
                        <dl class="row">
                            <dt class="col-sm-4">Description</dt>
                            <dd class="col-sm-8">@Model.Item.Description</dd>

                            <dt class="col-sm-4">Price</dt>
                            <dd class="col-sm-8">@Model.Item.Price.ToString("C")</dd>

                            <dt class="col-sm-4">Brand</dt>
                            <dd class="col-sm-8">@Model.Item.CatalogBrandName</dd>

                            <dt class="col-sm-4">Type</dt>
                            <dd class="col-sm-8">@Model.Item.CatalogTypeName</dd>
                        </dl>
                    </div>
                    <div class="col-md-6">
                        <dl class="row">
                            <dt class="col-sm-5">Available Stock</dt>
                            <dd class="col-sm-7">@Model.Item.AvailableStock</dd>

                            <dt class="col-sm-5">Restock Threshold</dt>
                            <dd class="col-sm-7">@Model.Item.RestockThreshold</dd>

                            <dt class="col-sm-5">Max Stock</dt>
                            <dd class="col-sm-7">@Model.Item.MaxStockThreshold</dd>

                            <dt class="col-sm-5">On Reorder</dt>
                            <dd class="col-sm-7">@(Model.Item.OnReorder ? "Yes" : "No")</dd>
                        </dl>
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-3">
            <a asp-page="/Catalog/Edit" asp-route-id="@Model.Item.Id" class="btn btn-warning">Edit</a>
            <a asp-page="/Catalog/Delete" asp-route-id="@Model.Item.Id" class="btn btn-danger">Delete</a>
            <a asp-page="/Index" class="btn btn-secondary">Back to List</a>
        </div>
    }
    else
    {
        <div class="alert alert-warning">Item not found.</div>
        <a asp-page="/Index" class="btn btn-secondary">Back to List</a>
    }
</div>
