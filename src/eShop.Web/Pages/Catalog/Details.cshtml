@page "{id:int}"
@model DetailsModel
@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Catalog Item</h4>
    <hr />
    @if (Model.Item != null)
    {
        <dl class="row">
            <dt class="col-sm-2">Name</dt>
            <dd class="col-sm-10">@Model.Item.Name</dd>

            <dt class="col-sm-2">Description</dt>
            <dd class="col-sm-10">@Model.Item.Description</dd>

            <dt class="col-sm-2">Price</dt>
            <dd class="col-sm-10">@Model.Item.Price.ToString("C")</dd>

            <dt class="col-sm-2">Picture</dt>
            <dd class="col-sm-10">
                <img src="~/pics/@Model.Item.PictureFileName" alt="@Model.Item.Name" style="max-width: 300px;" />
            </dd>

            <dt class="col-sm-2">Brand</dt>
            <dd class="col-sm-10">@Model.Item.CatalogBrand?.Brand</dd>

            <dt class="col-sm-2">Type</dt>
            <dd class="col-sm-10">@Model.Item.CatalogType?.Type</dd>

            <dt class="col-sm-2">Available Stock</dt>
            <dd class="col-sm-10">@Model.Item.AvailableStock</dd>

            <dt class="col-sm-2">Restock Threshold</dt>
            <dd class="col-sm-10">@Model.Item.RestockThreshold</dd>

            <dt class="col-sm-2">Max Stock</dt>
            <dd class="col-sm-10">@Model.Item.MaxStockThreshold</dd>

            <dt class="col-sm-2">On Reorder</dt>
            <dd class="col-sm-10">@(Model.Item.OnReorder ? "Yes" : "No")</dd>
        </dl>

        <div>
            <a asp-page="Edit" asp-route-id="@Model.Item.Id" class="btn btn-warning">Edit</a>
            <a asp-page="Index" class="btn btn-secondary">Back to List</a>
        </div>
    }
    else
    {
        <div class="alert alert-warning">Item not found.</div>
    }
</div>
