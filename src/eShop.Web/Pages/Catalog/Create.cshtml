@page
@model eShop.Web.Pages.Catalog.CreateModel
@{
    ViewData["Title"] = "Create Catalog Item";
}

<div class="container">
    <h1 class="my-4">Create Catalog Item</h1>

    <form method="post">
        <div class="row">
            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="Item.Name" class="form-label"></label>
                    <input asp-for="Item.Name" class="form-control" />
                    <span asp-validation-for="Item.Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Item.Description" class="form-label"></label>
                    <textarea asp-for="Item.Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Item.Description" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Item.Price" class="form-label"></label>
                    <input asp-for="Item.Price" class="form-control" type="number" step="0.01" />
                    <span asp-validation-for="Item.Price" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Item.PictureFileName" class="form-label"></label>
                    <input asp-for="Item.PictureFileName" class="form-control" />
                    <span asp-validation-for="Item.PictureFileName" class="text-danger"></span>
                </div>
            </div>

            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="Item.CatalogTypeId" class="form-label"></label>
                    <select asp-for="Item.CatalogTypeId" class="form-select" asp-items="Model.CatalogTypes">
                        <option value="">-- Select Type --</option>
                    </select>
                    <span asp-validation-for="Item.CatalogTypeId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Item.CatalogBrandId" class="form-label"></label>
                    <select asp-for="Item.CatalogBrandId" class="form-select" asp-items="Model.CatalogBrands">
                        <option value="">-- Select Brand --</option>
                    </select>
                    <span asp-validation-for="Item.CatalogBrandId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Item.AvailableStock" class="form-label"></label>
                    <input asp-for="Item.AvailableStock" class="form-control" type="number" />
                    <span asp-validation-for="Item.AvailableStock" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Item.RestockThreshold" class="form-label"></label>
                    <input asp-for="Item.RestockThreshold" class="form-control" type="number" />
                    <span asp-validation-for="Item.RestockThreshold" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Item.MaxStockThreshold" class="form-label"></label>
                    <input asp-for="Item.MaxStockThreshold" class="form-control" type="number" />
                    <span asp-validation-for="Item.MaxStockThreshold" class="text-danger"></span>
                </div>

                <div class="mb-3 form-check">
                    <input asp-for="Item.OnReorder" class="form-check-input" type="checkbox" />
                    <label asp-for="Item.OnReorder" class="form-check-label"></label>
                </div>
            </div>
        </div>

        <div class="mb-3">
            <button type="submit" class="btn btn-primary">Create</button>
            <a asp-page="/Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
