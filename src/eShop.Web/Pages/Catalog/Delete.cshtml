@page
@model eShop.Web.Pages.Catalog.DeleteModel
@{
    ViewData["Title"] = "Delete Catalog Item";
}

<h1>Delete Catalog Item</h1>

<h3>Are you sure you want to delete this?</h3>
<div class="row">
    <div class="col-md-6">
        @if (Model.CatalogItem != null)
        {
            <dl class="row">
                <dt class="col-sm-4">Name</dt>
                <dd class="col-sm-8">@Model.CatalogItem.Name</dd>

                <dt class="col-sm-4">Description</dt>
                <dd class="col-sm-8">@Model.CatalogItem.Description</dd>

                <dt class="col-sm-4">Price</dt>
                <dd class="col-sm-8">@Model.CatalogItem.Price.ToString("C")</dd>

                <dt class="col-sm-4">Type</dt>
                <dd class="col-sm-8">@Model.CatalogItem.CatalogType?.Type</dd>

                <dt class="col-sm-4">Brand</dt>
                <dd class="col-sm-8">@Model.CatalogItem.CatalogBrand?.Brand</dd>
            </dl>

            <form method="post">
                <input type="hidden" asp-for="CatalogItem.Id" />
                <button type="submit" class="btn btn-danger">Delete</button>
                <a asp-page="./Index" class="btn btn-secondary">Back to List</a>
            </form>
        }
        else
        {
            <p>Catalog item not found.</p>
            <a asp-page="./Index" class="btn btn-secondary">Back to List</a>
        }
    </div>
</div>
