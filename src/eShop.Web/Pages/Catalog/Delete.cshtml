@page "{id:int}"
@model DeleteModel
@{
    ViewData["Title"] = "Delete Catalog Item";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this item?</h3>
<div>
    <h4>Catalog Item</h4>
    <hr />
    @if (Model.Item != null)
    {
        <dl class="row">
            <dt class="col-sm-2">Name</dt>
            <dd class="col-sm-10">@Model.Item.Name</dd>

            <dt class="col-sm-2">Description</dt>
            <dd class="col-sm-10">@Model.Item.Description</dd>

            <dt class="col-sm-2">Price</dt>
            <dd class="col-sm-10">@Model.Item.Price.ToString("C")</dd>

            <dt class="col-sm-2">Picture</dt>
            <dd class="col-sm-10">
                <img src="~/pics/@Model.Item.PictureFileName" alt="@Model.Item.Name" style="max-width: 200px;" />
            </dd>

            <dt class="col-sm-2">Brand</dt>
            <dd class="col-sm-10">@Model.Item.CatalogBrand?.Brand</dd>

            <dt class="col-sm-2">Type</dt>
            <dd class="col-sm-10">@Model.Item.CatalogType?.Type</dd>

            <dt class="col-sm-2">Available Stock</dt>
            <dd class="col-sm-10">@Model.Item.AvailableStock</dd>
        </dl>

        <form method="post">
            <input type="hidden" asp-for="Item!.Id" />
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-page="Index" class="btn btn-secondary">Cancel</a>
        </form>
    }
    else
    {
        <div class="alert alert-warning">Item not found.</div>
    }
</div>
