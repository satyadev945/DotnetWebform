@page "{id:int}"
@model eShop.Web.Pages.Catalog.DeleteModel
@{
    ViewData["Title"] = "Delete Catalog Item";
}

<div class="container">
    <h1 class="my-4">Delete Catalog Item</h1>

    <div class="alert alert-warning">
        <h4>Are you sure you want to delete this item?</h4>
    </div>

    @if (Model.Item != null)
    {
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">@Model.Item.Name</h5>
                <dl class="row">
                    <dt class="col-sm-3">Description</dt>
                    <dd class="col-sm-9">@Model.Item.Description</dd>

                    <dt class="col-sm-3">Price</dt>
                    <dd class="col-sm-9">@Model.Item.Price.ToString("C")</dd>

                    <dt class="col-sm-3">Brand</dt>
                    <dd class="col-sm-9">@Model.Item.CatalogBrandName</dd>

                    <dt class="col-sm-3">Type</dt>
                    <dd class="col-sm-9">@Model.Item.CatalogTypeName</dd>

                    <dt class="col-sm-3">Available Stock</dt>
                    <dd class="col-sm-9">@Model.Item.AvailableStock</dd>
                </dl>
            </div>
        </div>

        <form method="post" class="mt-3">
            <input type="hidden" asp-for="Item.Id" />
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-page="/Index" class="btn btn-secondary">Cancel</a>
        </form>
    }
    else
    {
        <div class="alert alert-warning">Item not found.</div>
        <a asp-page="/Index" class="btn btn-secondary">Back to List</a>
    }
</div>
