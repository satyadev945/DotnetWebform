@page
@model eShop.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Home";
}

<div class="text-center">
    <img src="~/images/main_banner.png" alt="eShop Banner" class="img-fluid mb-4" />
    <h1 class="display-4">Welcome to eShop</h1>
    <p>Browse our catalog of products.</p>
</div>

<div class="row mt-4">
    @if (Model.CatalogItems != null && Model.CatalogItems.Any())
    {
        @foreach (var item in Model.CatalogItems)
        {
            <div class="col-md-3 mb-4">
                <div class="card">
                    <img src="~/Pics/@item.PictureFileName" class="card-img-top" alt="@item.Name" style="height: 200px; object-fit: cover;" />
                    <div class="card-body">
                        <h5 class="card-title">@item.Name</h5>
                        <p class="card-text">@item.Description</p>
                        <p class="card-text"><strong>@item.Price.ToString("C")</strong></p>
                        <a asp-page="/Catalog/Details" asp-route-id="@item.Id" class="btn btn-primary">Details</a>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12">
            <p class="text-center">No items available.</p>
        </div>
    }
</div>

@if (Model.TotalPages > 1)
{
    <nav aria-label="Page navigation">
        <ul class="pagination justify-content-center">
            @for (int i = 0; i < Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                    <a class="page-link" asp-page="/Index" asp-route-pageIndex="@i">@(i + 1)</a>
                </li>
            }
        </ul>
    </nav>
}
