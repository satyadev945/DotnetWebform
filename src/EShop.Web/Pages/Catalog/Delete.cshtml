@page "{id:int}"
@model EShop.Web.Pages.Catalog.DeleteModel
@{
    ViewData["Title"] = "Delete Catalog Item";
}

<div class="container">
    <h1>Delete Catalog Item</h1>

    <h3>Are you sure you want to delete this item?</h3>

    @if (Model.Item != null)
    {
        <div class="row">
            <div class="col-md-4">
                <img src="/Pics/@Model.Item.PictureFileName" alt="@Model.Item.Name" class="img-fluid" />
            </div>
            <div class="col-md-8">
                <dl class="row">
                    <dt class="col-sm-3">Name</dt>
                    <dd class="col-sm-9">@Model.Item.Name</dd>

                    <dt class="col-sm-3">Description</dt>
                    <dd class="col-sm-9">@Model.Item.Description</dd>

                    <dt class="col-sm-3">Price</dt>
                    <dd class="col-sm-9">@Model.Item.Price.ToString("C")</dd>

                    <dt class="col-sm-3">Brand</dt>
                    <dd class="col-sm-9">@Model.Item.CatalogBrand?.Brand</dd>

                    <dt class="col-sm-3">Type</dt>
                    <dd class="col-sm-9">@Model.Item.CatalogType?.Type</dd>
                </dl>

                <form method="post">
                    <input type="hidden" asp-for="Item.Id" />
                    <button type="submit" class="btn btn-danger">Delete</button>
                    <a asp-page="Index" class="btn btn-secondary">Cancel</a>
                </form>
            </div>
        </div>
    }
    else
    {
        <p>Item not found.</p>
    }
</div>
