@page
@model eShopOnWeb.Web.Pages.Catalog.DeleteModel
@{
    ViewData["Title"] = "Delete Catalog Item";
}

<div class="container">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <h2>Delete Catalog Item</h2>
            <h3 class="text-danger">Are you sure you want to delete this?</h3>
            <hr />

            @if (Model.Item != null)
            {
                <dl class="row">
                    <dt class="col-sm-3">Name</dt>
                    <dd class="col-sm-9">@Model.Item.Name</dd>

                    <dt class="col-sm-3">Description</dt>
                    <dd class="col-sm-9">@Model.Item.Description</dd>

                    <dt class="col-sm-3">Price</dt>
                    <dd class="col-sm-9">$@Model.Item.Price.ToString("F2")</dd>

                    <dt class="col-sm-3">Type</dt>
                    <dd class="col-sm-9">@Model.Item.CatalogTypeName</dd>

                    <dt class="col-sm-3">Brand</dt>
                    <dd class="col-sm-9">@Model.Item.CatalogBrandName</dd>
                </dl>

                <form method="post">
                    <input type="hidden" asp-for="Item.Id" />
                    <button type="submit" class="btn btn-danger">Delete</button>
                    <a asp-page="/Index" class="btn btn-secondary">Cancel</a>
                </form>
            }
            else
            {
                <div class="alert alert-warning">
                    Catalog item not found.
                </div>
                <a asp-page="/Index" class="btn btn-secondary">Back to List</a>
            }
        </div>
    </div>
</div>
