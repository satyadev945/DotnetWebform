@page
@model eShopOnWeb.Web.Pages.Catalog.DetailsModel
@{
    ViewData["Title"] = "Catalog Item Details";
}

<div class="container">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <h2>Catalog Item Details</h2>
            <hr />

            @if (Model.Item != null)
            {
                <dl class="row">
                    <dt class="col-sm-3">Name</dt>
                    <dd class="col-sm-9">@Model.Item.Name</dd>

                    <dt class="col-sm-3">Description</dt>
                    <dd class="col-sm-9">@Model.Item.Description</dd>

                    <dt class="col-sm-3">Price</dt>
                    <dd class="col-sm-9">$@Model.Item.Price.ToString("F2")</dd>

                    <dt class="col-sm-3">Picture</dt>
                    <dd class="col-sm-9">@Model.Item.PictureFileName</dd>

                    <dt class="col-sm-3">Type</dt>
                    <dd class="col-sm-9">@Model.Item.CatalogTypeName</dd>

                    <dt class="col-sm-3">Brand</dt>
                    <dd class="col-sm-9">@Model.Item.CatalogBrandName</dd>

                    <dt class="col-sm-3">Available Stock</dt>
                    <dd class="col-sm-9">@Model.Item.AvailableStock</dd>

                    <dt class="col-sm-3">Restock Threshold</dt>
                    <dd class="col-sm-9">@Model.Item.RestockThreshold</dd>

                    <dt class="col-sm-3">Max Stock Threshold</dt>
                    <dd class="col-sm-9">@Model.Item.MaxStockThreshold</dd>

                    <dt class="col-sm-3">On Reorder</dt>
                    <dd class="col-sm-9">@(Model.Item.OnReorder ? "Yes" : "No")</dd>
                </dl>

                <div class="mt-3">
                    <a asp-page="/Catalog/Edit" asp-route-id="@Model.Item.Id" class="btn btn-warning">Edit</a>
                    <a asp-page="/Index" class="btn btn-secondary">Back to List</a>
                </div>
            }
            else
            {
                <div class="alert alert-warning">
                    Catalog item not found.
                </div>
                <a asp-page="/Index" class="btn btn-secondary">Back to List</a>
            }
        </div>
    </div>
</div>
