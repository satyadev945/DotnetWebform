@page "{id:int}"
@model eShopMigrated.Web.Pages.Catalog.DetailsModel
@{
    ViewData["Title"] = "Catalog Item Details";
}

<div class="container">
    <h1>Catalog Item Details</h1>

    <hr />

    <div class="row">
        <div class="col-md-6">
            <dl class="row">
                <dt class="col-sm-4">Name</dt>
                <dd class="col-sm-8">@Model.CatalogItem.Name</dd>

                <dt class="col-sm-4">Description</dt>
                <dd class="col-sm-8">@Model.CatalogItem.Description</dd>

                <dt class="col-sm-4">Price</dt>
                <dd class="col-sm-8">@Model.CatalogItem.Price.ToString("C")</dd>

                <dt class="col-sm-4">Brand</dt>
                <dd class="col-sm-8">@Model.CatalogItem.CatalogBrandName</dd>

                <dt class="col-sm-4">Type</dt>
                <dd class="col-sm-8">@Model.CatalogItem.CatalogTypeName</dd>

                <dt class="col-sm-4">Picture</dt>
                <dd class="col-sm-8">
                    <img src="/Pics/@Model.CatalogItem.PictureFileName" alt="@Model.CatalogItem.Name" style="max-width: 200px;" />
                </dd>

                <dt class="col-sm-4">Available Stock</dt>
                <dd class="col-sm-8">@Model.CatalogItem.AvailableStock</dd>

                <dt class="col-sm-4">Restock Threshold</dt>
                <dd class="col-sm-8">@Model.CatalogItem.RestockThreshold</dd>

                <dt class="col-sm-4">Max Stock Threshold</dt>
                <dd class="col-sm-8">@Model.CatalogItem.MaxStockThreshold</dd>

                <dt class="col-sm-4">On Reorder</dt>
                <dd class="col-sm-8">@(Model.CatalogItem.OnReorder ? "Yes" : "No")</dd>
            </dl>

            <div>
                <a asp-page="Edit" asp-route-id="@Model.CatalogItem.Id" class="btn btn-warning">Edit</a>
                <a asp-page="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </div>
    </div>
</div>
