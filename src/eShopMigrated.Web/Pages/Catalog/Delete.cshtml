@page "{id:int}"
@model eShopMigrated.Web.Pages.Catalog.DeleteModel
@{
    ViewData["Title"] = "Delete Catalog Item";
}

<div class="container">
    <h1>Delete Catalog Item</h1>

    <h3>Are you sure you want to delete this?</h3>

    <hr />

    <div class="row">
        <div class="col-md-6">
            <dl class="row">
                <dt class="col-sm-4">Name</dt>
                <dd class="col-sm-8">@Model.CatalogItem.Name</dd>

                <dt class="col-sm-4">Description</dt>
                <dd class="col-sm-8">@Model.CatalogItem.Description</dd>

                <dt class="col-sm-4">Price</dt>
                <dd class="col-sm-8">@Model.CatalogItem.Price.ToString("C")</dd>

                <dt class="col-sm-4">Brand</dt>
                <dd class="col-sm-8">@Model.CatalogItem.CatalogBrandName</dd>

                <dt class="col-sm-4">Type</dt>
                <dd class="col-sm-8">@Model.CatalogItem.CatalogTypeName</dd>

                <dt class="col-sm-4">Picture</dt>
                <dd class="col-sm-8">
                    <img src="/Pics/@Model.CatalogItem.PictureFileName" alt="@Model.CatalogItem.Name" style="max-width: 200px;" />
                </dd>
            </dl>

            <form method="post">
                <input type="hidden" asp-for="CatalogItem.Id" />
                <button type="submit" class="btn btn-danger">Delete</button>
                <a asp-page="Index" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>
