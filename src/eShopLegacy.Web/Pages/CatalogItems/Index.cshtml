@page
@model CatalogItems.IndexModel
@{
    ViewData["Title"] = "Catalog Items";
}

<h1>Catalog Items</h1>

<p>
    <a asp-page="Create" class="btn btn-primary">Create New</a>
</p>

@if (Model.ErrorMessage != null)
{
    <div class="alert alert-danger" role="alert">
        @Model.ErrorMessage
    </div>
}

<div class="row mb-3">
    <div class="col-md-6">
        <form method="get">
            <div class="input-group">
                <input type="text" name="searchString" value="@Model.SearchString" class="form-control" placeholder="Search catalog items..." />
                <button type="submit" class="btn btn-outline-secondary">Search</button>
            </div>
        </form>
    </div>
</div>

@if (Model.CatalogItems.Any())
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Name</th>
                <th>Description</th>
                <th>Price</th>
                <th>Brand</th>
                <th>Type</th>
                <th>Stock</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.CatalogItems)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@(string.IsNullOrEmpty(item.Description) ? "" : item.Description.Substring(0, Math.Min(50, item.Description.Length)) + (item.Description.Length > 50 ? "..." : ""))</td>
                    <td>$@item.Price.ToString("F2")</td>
                    <td>@item.CatalogBrand?.Brand</td>
                    <td>@item.CatalogType?.Type</td>
                    <td>@item.AvailableStock</td>
                    <td>
                        <a asp-page="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Details</a>
                        <a asp-page="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                        <a asp-page="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (Model.TotalPages > 1)
    {
        <nav>
            <ul class="pagination">
                @if (Model.PageIndex > 0)
                {
                    <li class="page-item">
                        <a class="page-link" asp-page="./Index" asp-route-pageIndex="@(Model.PageIndex - 1)" asp-route-searchString="@Model.SearchString">Previous</a>
                    </li>
                }
                @for (int i = 0; i < Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                        <a class="page-link" asp-page="./Index" asp-route-pageIndex="@i" asp-route-searchString="@Model.SearchString">@(i + 1)</a>
                    </li>
                }
                @if (Model.PageIndex < Model.TotalPages - 1)
                {
                    <li class="page-item">
                        <a class="page-link" asp-page="./Index" asp-route-pageIndex="@(Model.PageIndex + 1)" asp-route-searchString="@Model.SearchString">Next</a>
                    </li>
                }
            </ul>
        </nav>
    }
}
else
{
    <div class="alert alert-info" role="alert">
        No catalog items found.
    </div>
}
