@page
@model CatalogItems.DetailsModel
@{
    ViewData["Title"] = "Catalog Item Details";
}

<h1>Catalog Item Details</h1>

@if (Model.CatalogItem == null)
{
    <div class="alert alert-warning" role="alert">
        Catalog item not found.
    </div>
    <a asp-page="Index" class="btn btn-secondary">Back to List</a>
}
else
{
    <div>
        <hr />
        <dl class="row">
            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9">@Model.CatalogItem.Name</dd>

            <dt class="col-sm-3">Description</dt>
            <dd class="col-sm-9">@Model.CatalogItem.Description</dd>

            <dt class="col-sm-3">Price</dt>
            <dd class="col-sm-9">$@Model.CatalogItem.Price.ToString("F2")</dd>

            <dt class="col-sm-3">Picture</dt>
            <dd class="col-sm-9">@Model.CatalogItem.PictureFileName</dd>

            <dt class="col-sm-3">Brand</dt>
            <dd class="col-sm-9">@Model.CatalogItem.CatalogBrand?.Brand</dd>

            <dt class="col-sm-3">Type</dt>
            <dd class="col-sm-9">@Model.CatalogItem.CatalogType?.Type</dd>

            <dt class="col-sm-3">Available Stock</dt>
            <dd class="col-sm-9">@Model.CatalogItem.AvailableStock</dd>

            <dt class="col-sm-3">Restock Threshold</dt>
            <dd class="col-sm-9">@Model.CatalogItem.RestockThreshold</dd>

            <dt class="col-sm-3">Max Stock Threshold</dt>
            <dd class="col-sm-9">@Model.CatalogItem.MaxStockThreshold</dd>

            <dt class="col-sm-3">On Reorder</dt>
            <dd class="col-sm-9">@(Model.CatalogItem.OnReorder ? "Yes" : "No")</dd>

            <dt class="col-sm-3">Created Date</dt>
            <dd class="col-sm-9">@Model.CatalogItem.CreatedDate.ToString("g")</dd>

            @if (Model.CatalogItem.ModifiedDate.HasValue)
            {
                <dt class="col-sm-3">Modified Date</dt>
                <dd class="col-sm-9">@Model.CatalogItem.ModifiedDate.Value.ToString("g")</dd>
            }

            <dt class="col-sm-3">Created By</dt>
            <dd class="col-sm-9">@Model.CatalogItem.CreatedBy</dd>

            @if (!string.IsNullOrEmpty(Model.CatalogItem.ModifiedBy))
            {
                <dt class="col-sm-3">Modified By</dt>
                <dd class="col-sm-9">@Model.CatalogItem.ModifiedBy</dd>
            }

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">@(Model.CatalogItem.IsActive ? "Active" : "Inactive")</dd>
        </dl>
    </div>
    <div>
        <a asp-page="Edit" asp-route-id="@Model.CatalogItem.Id" class="btn btn-warning">Edit</a>
        <a asp-page="Index" class="btn btn-secondary">Back to List</a>
    </div>
}
