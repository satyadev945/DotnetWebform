@page
@model CatalogItems.DeleteModel
@{
    ViewData["Title"] = "Delete Catalog Item";
}

<h1>Delete Catalog Item</h1>

@if (Model.CatalogItem == null)
{
    <div class="alert alert-warning" role="alert">
        Catalog item not found.
    </div>
    <a asp-page="Index" class="btn btn-secondary">Back to List</a>
}
else
{
    <h3>Are you sure you want to delete this item?</h3>
    <div>
        <hr />
        <dl class="row">
            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9">@Model.CatalogItem.Name</dd>

            <dt class="col-sm-3">Description</dt>
            <dd class="col-sm-9">@Model.CatalogItem.Description</dd>

            <dt class="col-sm-3">Price</dt>
            <dd class="col-sm-9">$@Model.CatalogItem.Price.ToString("F2")</dd>

            <dt class="col-sm-3">Brand</dt>
            <dd class="col-sm-9">@Model.CatalogItem.CatalogBrand?.Brand</dd>

            <dt class="col-sm-3">Type</dt>
            <dd class="col-sm-9">@Model.CatalogItem.CatalogType?.Type</dd>

            <dt class="col-sm-3">Available Stock</dt>
            <dd class="col-sm-9">@Model.CatalogItem.AvailableStock</dd>
        </dl>

        <form method="post">
            <input type="hidden" asp-for="CatalogItem.Id" />
            <input type="submit" value="Delete" class="btn btn-danger" />
            <a asp-page="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
}
